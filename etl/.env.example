POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=timtruongdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
# Chọn provider: gemini (mặc định) | openai (mọi endpoint OpenAI-compatible)
LLM_PROVIDER=gemini

# --- Khi LLM_PROVIDER=gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Khi LLM_PROVIDER=openai (OpenRouter / OpenCode / ...) ---
# OPENAI_API_KEY=your_openrouter_or_opencode_key
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_MODEL=mimo-v2.5

# --- Cloudflare R2 (chỉ etl_images.py dùng) ---
# Dashboard → R2 → Manage R2 API Tokens → Create API token (quyền Object Read & Write, chỉ bucket này)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
