{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "timtruong",
	"main": "worker/index.ts",
	"upload_source_maps": true,
	"compatibility_date": "2026-11-22",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"API_BASE_URL": "https://api.timtruong.app"
	}
}
