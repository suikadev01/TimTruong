{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "timtruong",
	"main": "worker/index.ts",
	"upload_source_maps": true,
	"compatibility_date": "2026-11-22",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": ["nodejs_compat"],
	// The Cloudflare Vite plugin sets the directory; the binding lets the Worker
	// check whether a generated preview image exists (worker/index.ts).
	"assets": {
		"binding": "ASSETS"
	},
	"vars": {
		"API_BASE_URL": "https://api.timtruong.app"
	}
}
